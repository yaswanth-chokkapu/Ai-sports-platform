# ==============================================================================
# AthleteX - Root .gitignore
# ==============================================================================

# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/

# Python Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Node & Frontend dependencies and builds
node_modules/
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
*.local

# Environment variables & secrets (preserve .env.example)
.env
.env.*
!.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example

# Logs & temp files
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor & OS files
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db
